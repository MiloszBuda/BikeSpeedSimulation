# Backend FastAPI URL (domyślnie chmura Render lub lokalnie http://localhost:8000)
VITE_API_URL=https://bikespeedsimulation.onrender.com

# CARTO Basemaps API Key (opcjonalny - publiczne kafelki działają domyślnie bez klucza)
# Jeśli posiadasz klucz API z panelu CARTO Developer, wklej go poniżej:
VITE_CARTO_API_KEY=

# Opcjonalny niestandardowy URL kafelków (np. własny raster tile URL z CARTO)
# VITE_CARTO_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
